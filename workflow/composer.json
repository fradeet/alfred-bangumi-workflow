{
  "name": "fradeet/alfred-bangumi-workflow",
  "description": "For create Alfred workflow easily",
  "type": "project",
  "require": {
    "php": ">=8.3",
    "saloonphp/saloon": "^4.0"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.95",
    "phpstan/phpstan": "^2.2",
    "symfony/var-dumper": "^8.1"
  },
  "license": "GPL-3.0-only",
  "authors": [
    {
      "name": "Fradeet Y.",
      "email": "41571697+fradeet@users.noreply.github.com"
    }
  ],
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "autoload": {
    "psr-4": {
      "Alfred\\Workflow\\AlfredAdapter\\": "src/AlfredAdapter/types/",
      "Alfred\\Workflow\\": "src/"
    }
  }
}
